# 维护方服务密钥（必填，生产环境请使用足够长的随机串，例如：openssl rand -base64 48）
SERVICE_KEY=change-me-please-use-a-long-random-secret

# PostgreSQL 连接串（compose 内默认指向 db 服务，一般无需修改）
DATABASE_URL=postgresql://redact:redact@db:5432/redaction

# 单次提交原文的最大 Unicode 码点数
MAX_CONTENT_CODEPOINTS=1000000
# 单次提交区间的最大条数
MAX_RANGES=10000
# 读取令牌允许设置的最长有效期（秒），默认一年；缺省 expires_in_seconds 时令牌不过期
MAX_TOKEN_TTL_SECONDS=31536000
